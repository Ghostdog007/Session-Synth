# Datasets: Ignore massive video files, but keep the folder
datasets/*.mp4
datasets/*.mkv
datasets/*.avi
datasets/*.mov
!datasets/.gitkeep

# Cache: Ignore all temporary audio chunks, but keep the folder
cache/*
!cache/.gitkeep

# Outputs: Ignore generated JSONs, but keep the folder
outputs/*.json
!outputs/.gitkeep

